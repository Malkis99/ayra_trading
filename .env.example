# Environment variables template for AYRA Trading
# Copy this file to .env.local for local development

# Supabase Configuration
# Required for auth and cloud database functionality (T7a+).
# If these variables are omitted or empty, AYRA runs in local guest mode.
# NEVER put real secret values (SUPABASE_SERVICE_ROLE_KEY and others) in this file or in client code: names only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional Main Site URL (T7a.1)
# Used for site URL mismatch detection and email redirect callback configuration.
# Example: https://ayratrading.com
NEXT_PUBLIC_SITE_URL=

# Optional CI Testing Flag
# Strictly for CI / Playwright test mocking. Must NOT be enabled in production outside CI.
# AYRA_E2E_AUTH_MOCK=0

# Market feeds collector (server only, set in Vercel; docs/market-feeds-plan.md section 4).
# SUPABASE_SERVICE_ROLE_KEY: Supabase -> Project Settings -> API keys -> service_role (secret). Never in client code.
# MARKET_FEEDS_SECRET: any long random value; the same one goes into supabase/setup/market_feeds_cron.sql.
# BLS_API_KEY: optional free key from https://data.bls.gov/registrationEngine/ (500 requests a day instead of 25).
# EIA_API_KEY: free key from https://www.eia.gov/opendata/register.php (EIA weekly crude oil and gas storage figures).
SUPABASE_SERVICE_ROLE_KEY=
MARKET_FEEDS_SECRET=
BLS_API_KEY=
EIA_API_KEY=
# Required for Census data queries; free: https://api.census.gov/data/key_signup.html
# Server-only. Set in Vercel environment variables, never NEXT_PUBLIC_ or committed values.
CENSUS_API_KEY=
